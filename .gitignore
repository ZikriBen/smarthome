cat >> ~/smarthome/.gitignore <<'EOF'

# Python
__pycache__/
*.py[cod]
.venv/

# macOS
.DS_Store

# Secrets
.env
.env.*
!.env.example

# Docker persistent data
**/data/
**/*_data/

# Logs
*.log
EOF

.env
.env.*
!.env.example

# Telegram downloader PoC
telegram-downloader-poc/.venv/
telegram-downloader-poc/*.session
telegram-downloader-poc/*.session-journal
telegram-downloader-poc/downloads/*
!telegram-downloader-poc/downloads/.gitkeep

# Telegram downloader
telegram-downloader/.env
telegram-downloader/data/*
!telegram-downloader/data/.gitkeep
telegram-downloader/**/*.session
telegram-downloader/**/*.session-journal
telegram-downloader-poc/

# Jellyfin runtime data
jellyfin/cache/
jellyfin/config/

# Local development / PoCs
telegram-fast-download-poc/
