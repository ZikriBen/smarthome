#!/usr/bin/env python3
"""Test double for `systemd-creds encrypt|decrypt` (reversible, NOT secure).

encrypt [--with-key=K] --name=N - OUT   (plaintext on stdin)
decrypt --name=N IN -                   (plaintext on stdout)
The ciphertext is base64(XOR) with a header binding the name, like the real tool
(decrypt fails on a name mismatch). MOCK_CREDS_FAIL=<name> makes decrypting that
credential fail. MOCK_CREDS_ARGV_LOG=<file> appends argv (to prove no value in argv).
"""
import base64, os, sys

KEY = b"mock-key-not-secure"


def xor(b):
    return bytes(c ^ KEY[i % len(KEY)] for i, c in enumerate(b))


def main(argv):
    if os.environ.get("MOCK_CREDS_ARGV_LOG"):
        with open(os.environ["MOCK_CREDS_ARGV_LOG"], "a") as fh:
            fh.write(" ".join(argv) + "\n")
    if not argv:
        return 2
    op, rest = argv[0], argv[1:]
    name = next((a.split("=", 1)[1] for a in rest if a.startswith("--name=")), None)
    pos = [a for a in rest if not a.startswith("--")]
    if name is None or len(pos) != 2:
        print("mock: bad usage", file=sys.stderr)
        return 2
    src, dst = pos
    if op == "encrypt":
        data = sys.stdin.buffer.read() if src == "-" else open(src, "rb").read()
        blob = b"MOCKCRED1\n" + name.encode() + b"\n" + base64.b64encode(xor(data)) + b"\n"
        with open(dst, "wb") as fh:
            fh.write(blob)
        return 0
    if op == "decrypt":
        if os.environ.get("MOCK_CREDS_FAIL") == name:
            print(f"mock: failed to decrypt {src}", file=sys.stderr)
            return 1
        lines = open(src, "rb").read().split(b"\n")
        if lines[0] != b"MOCKCRED1" or lines[1].decode() != name:
            print("mock: name mismatch", file=sys.stderr)
            return 1
        data = xor(base64.b64decode(lines[2]))
        if dst == "-":
            sys.stdout.buffer.write(data)
        else:
            open(dst, "wb").write(data)
        return 0
    return 2


sys.exit(main(sys.argv[1:]))
