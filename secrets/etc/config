# /etc/smarthome-secrets/config (installed by install-host.sh)
REPO_ROOT=/home/ben/smarthome
# systemd-creds key: host = /var/lib/systemd/credential.secret (default, survives
# firmware/TPM changes). auto/tpm2 also bind to the TPM (lost if the TPM is cleared).
WITH_KEY=host
COMPOSE_CMD=docker compose
