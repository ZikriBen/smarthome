#!/bin/sh
# secrets-env-shim — for images that read secrets only from env vars.
#
# Mounted read-only into the container (e.g. /usr/local/bin/secrets-env-shim) and
# used as the compose `entrypoint:` in front of the image's original entrypoint/cmd:
#
#   SECRETS_FROM_FILES="FOO BAR"            explicit allowlist (space or comma separated)
#   FOO_FILE=/run/secrets/FOO               for every allowlisted name
#
# For each allowlisted NAME: read ${NAME}_FILE, strip ONE trailing newline, export
# NAME, unset NAME_FILE. Any *_FILE NOT in the allowlist is left untouched (images
# with a legitimate *_FILE keep working). Then `exec "$@"` (PID is preserved, so a
# PID-1 entrypoint such as s6-overlay still sees $$ = 1).
#
# The value lives only in the process environment of the exec'd program; it is
# never printed and never appears in `docker inspect` (the container config only
# holds the *_FILE path). Fails closed: a missing/unreadable/empty file exits non-zero.
set -eu

nl='
'
allow=$(printf '%s' "${SECRETS_FROM_FILES:-}" | tr ',' ' ')
unset SECRETS_FROM_FILES

for name in $allow; do
    case "$name" in
        ''|[!A-Z_]*|*[!A-Z0-9_]*)
            echo "secrets-env-shim: invalid name in SECRETS_FROM_FILES" >&2
            exit 64
            ;;
    esac
    eval "path=\${${name}_FILE:-}"
    if [ -z "$path" ]; then
        echo "secrets-env-shim: ${name}_FILE is not set" >&2
        exit 64
    fi
    if [ ! -f "$path" ] || [ ! -r "$path" ]; then
        echo "secrets-env-shim: cannot read the file for ${name}" >&2
        exit 66
    fi
    # $(...) strips ALL trailing newlines; the sentinel keeps them, then drop exactly one.
    value=$(cat -- "$path"; printf x)
    value=${value%x}
    value=${value%"$nl"}
    if [ -z "$value" ]; then
        echo "secrets-env-shim: the file for ${name} is empty" >&2
        exit 65
    fi
    export "$name=$value"
    unset "${name}_FILE"
    value=
    echo "secrets-env-shim: loaded ${name}" >&2
done
unset nl allow name path value

if [ "$#" -eq 0 ]; then
    echo "secrets-env-shim: no command to exec" >&2
    exit 64
fi
exec "$@"
