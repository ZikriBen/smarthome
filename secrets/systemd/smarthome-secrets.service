# Decrypt /etc/credstore.encrypted/smarthome/<svc>.<NAME> (systemd-creds) into the
# tmpfs /run/smarthome-secrets/<svc>/<NAME> (0400, owner from owners.conf) before
# Docker starts any container. Idempotent; removes orphans. Re-run after a change:
#   sudo smarthome-secrets refresh     (= systemctl restart smarthome-secrets.service)
[Unit]
Description=smarthome secrets: decrypt systemd-creds into /run/smarthome-secrets
Documentation=file:///home/ben/smarthome/secrets/README.md
DefaultDependencies=no
After=local-fs.target systemd-tmpfiles-setup.service
Before=docker.service containerd.service
ConditionPathIsDirectory=/etc/credstore.encrypted/smarthome

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/smarthome-secrets apply
UMask=0077
# Hardening: the tool only reads the credstore + host key and writes /run/smarthome-secrets.
NoNewPrivileges=yes
PrivateNetwork=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/run
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
SystemCallArchitectures=native
CapabilityBoundingSet=CAP_CHOWN CAP_FOWNER CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH

[Install]
WantedBy=multi-user.target docker.service
