# Hermes runtime state; only our config is tracked
hermes/*
!hermes/config.yaml
!hermes/SOUL.md
!hermes/Dockerfile
!hermes/entrypoint-network-guard.sh
!hermes/telegram-adapter.py
!hermes/cc_approvals.py
!hermes/tests/
hermes/tests/__pycache__/
!hermes/plugins/
hermes/plugins/*
!hermes/plugins/otp-relay/
hermes/plugins/otp-relay/__pycache__/

# OAuth client configuration and refreshed user tokens are server-only.
google/

# Service credential files mounted read-only into containers (e.g. secrets/tmdb/ for the season finder).
secrets/
