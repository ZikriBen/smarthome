[Unit]
Description=Card sync on demand, all card accounts (one approved request = one account, one login)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
# Secrets: sealed with systemd-creds by Ben (card-setup <account>); decrypted only for this unit into
# $CREDENTIALS_DIRECTORY. The LoadCredentialEncrypted= lines live in the GENERATED drop-in
# cal-run.service.d/creds.conf (card-setup / setup-cal-host.sh write one line per sealed file that exists:
# card-<account>.<field>, plus the legacy cal.username / cal.password for cal-main), because a missing file in
# LoadCredentialEncrypted= would stop the unit from starting.
UMask=0077
PrivateTmp=yes
ProtectHome=read-only
# ProtectHome=read-only: allow data/cal (out/ + archive/) and the OTP inbox.
ReadWritePaths=/home/ben/smarthome/data/cal /home/ben/smarthome/home-agent/hermes/otp
NoNewPrivileges=yes
Environment=CAL_SPOOL_DIR=/var/lib/cal-spool
Environment=CAL_STATE_DIR=/var/lib/cal
Environment=CAL_OUT_DIR=/home/ben/smarthome/data/cal/out
Environment=CAL_ARCHIVE_DIR=/home/ben/smarthome/data/cal/archive
Environment=CAL_OUT_UID=1000
Environment=CAL_OUT_GID=1000
Environment=CAL_INBOX_DB=/home/ben/smarthome/home-agent/hermes/otp/codes.sqlite
Environment=CAL_OTP_TIMEOUT=120
Environment=CAL_MONTHS=3
Environment=CAL_RETENTION_DAYS=7
Environment=CAL_REPULL_DAYS=10
# Daily login cap. Override with a drop-in, e.g. /etc/systemd/system/cal-run.service.d/limits.conf:
#   [Service]
#   Environment=CAL_MAX_RUNS_PER_DAY=3
Environment=CAL_MAX_RUNS_PER_DAY=2
# Accounts registry (root, not secret) and per-account caps: /etc/card-accounts.json (max_runs_per_day, default
# CAL_MAX_RUNS_PER_DAY). Optional global cap over all card accounts per day (0 = off; registry max_runs_total too).
Environment=CARD_ACCOUNTS=/etc/card-accounts.json
Environment=CARD_MAX_RUNS_TOTAL=0
# One bank login at a time: also hold the Hapoalim runner's lock (non-blocking; busy -> LOCKED).
Environment=CARD_BANK_LOCK=/var/lib/hapoalim/run.lock
EnvironmentFile=/etc/cal/image.env
ExecStart=/usr/local/lib/hapoalim/cal-runner.py
TimeoutStartSec=20min
Nice=10
