# Installed by host/setup-host.sh. Fires hapoalim-run.service when the Command Center drops an approved
# request.json (written only by the approvals handler `hapoalim_run_report`).
[Path]
PathExists=/var/lib/hapoalim-spool/request.json
Unit=hapoalim-run.service

[Install]
WantedBy=multi-user.target
