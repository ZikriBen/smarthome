OPENAI_API_KEY=
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user ids allowed to talk to the bot.
TELEGRAM_ALLOWED_USERS=
# Home channel (cron/proactive delivery): numeric chat id (a DM chat id == that user's id) + label.
TELEGRAM_HOME_CHANNEL=
TELEGRAM_HOME_CHANNEL_NAME=Home
# otp-relay plugin: numeric user id of your SMS-forward bot and the private chat it posts in. Empty = inert.
OTP_FORWARD_BOT_ID=
OTP_FORWARD_CHAT_ID=
# openssl rand -hex 32
SEARXNG_SECRET=
COMMAND_CENTER_TOKEN=
# Dedicated token used only when an authorized person taps an in-chat
# Command Center approval button. Generate with: openssl rand -hex 32
COMMAND_CENTER_CALLBACK_TOKEN=
# Read-only Uptime Kuma Prometheus API key. Create it in Uptime Kuma → Settings → Security → API Keys.
UPTIME_KUMA_API_KEY=
JELLYFIN_API_KEY=
# Optional (season finder): TMDb v4 read token (preferred) or v3 API key. Prefer the file route instead:
# home-agent/secrets/tmdb/tmdb_read_token (0600). Leave empty here unless you deliberately use .env.
TMDB_READ_TOKEN=
TMDB_API_KEY=
# Rami Levy store id to search (empty = the site's guest store 331).
GROCERY_STORE=
