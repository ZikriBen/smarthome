TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Lulu / catalog source
TELEGRAM_SOURCE_CHAT_ID=-100XXXXXXXXXX

# SearchGram
SEARCH_CHAT_ID=-100XXXXXXXXXX
# Allowed delivery bots. The callback URL selects the correct bot for each
# result; never send a token to a bot that is not listed here.
SEARCH_DELIVERY_BOTS=searchgram_bbot,searchgram_robot

# Persistent Telethon session inside container
TELEGRAM_SESSION=/data/telegram-browser

# Browser catalog
CATALOG_DATABASE_PATH=/data/catalog.db

# Downloader API
# UI title shown in the browser
BRAND_NAME=Media Browser

# Server LAN address (used for defaults and published ports)
LAN_IP=192.0.2.10
DOWNLOADER_URL=http://192.0.2.10:8787

# Catalog synchronization
INITIAL_SYNC_MESSAGES=600
BACKFILL_MESSAGES=500
BACKFILL_PAUSE_SECONDS=1
NEWER_SYNC_INTERVAL_SECONDS=60

# Poster cache
POSTER_CACHE_MAX_GB=2

# Season finder (POST /api/search/season). All optional; defaults shown.
# Ranking: smallest sufficient file. Sufficient = resolution >= SEASON_MIN_RES when it is in the title,
# otherwise size >= SEASON_FLOOR_MB_PER_MIN x runtime. Below SEASON_HARD_MIN_MB_PER_MIN = broken (never picked);
# above SEASON_MAX_MB_PER_MIN = remux-sized (only when nothing smaller is sufficient).
# SEASON_MIN_RES=720
# SEASON_FLOOR_MB_PER_MIN=4
# SEASON_HARD_MIN_MB_PER_MIN=1.5
# SEASON_MAX_MB_PER_MIN=60
# SEASON_DEFAULT_RUNTIME_MIN=45
# SEASON_SIZE_TIE_PCT=10
# SEASON_PACK_MIN_RANGE=4
# Scan limits
# SEASON_MAX_PAGES_PER_QUERY=6
# SEASON_MAX_PAGES_TOTAL=14
# SEASON_PAGE_DELAY_SECONDS=1
# SEASON_STEP_TIMEOUT_SECONDS=40
# SEASON_BUDGET_SECONDS=150
