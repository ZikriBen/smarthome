:80 {
	handle_path /ha* {
		reverse_proxy host.docker.internal:8123
	}

	handle_path /beszel* {
		reverse_proxy host.docker.internal:8090
	}
	handle_path /kuma* {
		reverse_proxy host.docker.internal:3001 {
			header_down Location ^/(.*)$ /kuma/$1
		}
	}

	handle {
		reverse_proxy host.docker.internal:7575
	}
}

:8091 {
	# Credentials come from the container env (caddy/.env, git-ignored; compose env_file), never from git.
	# Hash: docker run --rm caddy:latest caddy hash-password
	basicauth {
		{$CADDY_BASIC_AUTH_USER} {$CADDY_BASIC_AUTH_HASH}
	}

	handle {
		reverse_proxy host.docker.internal:8788
	}
}
