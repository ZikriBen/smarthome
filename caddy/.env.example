# Basic-auth for the :8091 catalog front door (conf/Caddyfile).
# Generate the hash with:  docker run --rm caddy:latest caddy hash-password
# Keep the single quotes: compose would otherwise try to interpolate the '$' signs in the bcrypt hash.
CADDY_BASIC_AUTH_USER=admin
CADDY_BASIC_AUTH_HASH='$2a$14$REPLACE_WITH_OUTPUT_OF_caddy_hash-password'
