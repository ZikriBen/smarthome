# IMAP
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_PASS=
IMAP_MAILBOX=INBOX

# Filtering
EMAIL_SENDER=
EXACT_MATCH=true

# RSS settings
RSS_TITLE=Email RSS Feed
RSS_LINK=http://localhost:8000/rss
MAX_ITEMS=50

# Polling interval in seconds (e.g., 3600 = 1 hour)
POLL_INTERVAL=3600

# Persistent state inside container
STATE_FILE=/data/state.json
LOG_LEVEL=INFO
